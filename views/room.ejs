<% const bodyClass = 'in-room'; %>
<%- include('partials/head', { bodyClass }) %>
<div class="room" id="room" data-code="<%= room.code %>">
  <header class="room-bar">
    <a href="/" class="logo" title="Return to connectme home"><img src="/favicon.svg" alt="" width="28" height="28"><span>connectme</span></a>
    <div class="room-heading">
      <strong><%= room.name %></strong>
      <span><span class="room-live-dot"></span> Meeting room</span>
    </div>
    <span class="timer" id="timer" title="Time remaining in this meeting" hidden><%- include('partials/icon', { n: 'clock' }) %> <span id="timer-text"></span></span>
  </header>
  <div class="room-body">
    <main class="chat" aria-label="Meeting chat">
      <div class="chat-heading">
        <strong><%- include('partials/icon', { n: 'chat' }) %> Meeting chat</strong>
        <span>Messages, images, PDFs up to 4 MB, and videos up to 5 MB</span>
      </div>
      <section class="room-call-panel" aria-label="Call controls">
        <div>
          <strong id="call-state-label">No call is active</strong>
          <span id="call-state-help">The admin can start an audio or video call.</span>
        </div>
        <div class="call-actions">
          <button class="btn btn-primary" id="call-start-audio" type="button" hidden>Start audio call</button>
          <button class="btn btn-primary" id="call-start-video" type="button" hidden>Start video call</button>
          <button class="btn btn-danger" id="call-end" type="button" hidden>End call</button>
          <a class="btn btn-primary" id="call-join" hidden>Join call</a>
          <a class="btn btn-light" id="call-view" target="_blank" rel="noopener" hidden>View participants</a>
        </div>
      </section>
      <div class="chat-log" id="chat-log" aria-live="polite"></div>
      <form class="chat-form" id="chat-form">
        <label class="icon-btn" title="Attach an image, PDF, or video" aria-label="Attach an image, PDF, or video"><%- include('partials/icon', { n: 'image' }) %>
          <input type="file" id="image-input" accept="image/png,image/jpeg,image/gif,image/webp,application/pdf,video/mp4,video/webm" hidden></label>
        <input id="chat-input" placeholder="Message everyone" autocomplete="off" aria-label="Message">
        <button class="btn btn-primary icon-only" title="Send message" aria-label="Send message"><%- include('partials/icon', { n: 'send' }) %></button>
      </form>
    </main>
    <aside class="member-panel" aria-label="Meeting members">
      <div class="member-heading">
        <strong>In this room</strong>
        <span id="member-count">0 members</span>
      </div>
      <ul class="member-list" id="member-list" aria-live="polite"></ul>
    </aside>
  </div>
  <div class="overlay" id="join-overlay">
    <form class="panel" id="name-form">
      <h1><%= room.name %></h1>
      <p>Join the room to chat and see who is here. Your camera and microphone are only requested if you join a call.</p>
      <label>Your name<input id="name-input" maxlength="40" required autofocus></label>
      <button class="btn btn-primary btn-lg">Join room</button>
    </form>
  </div>
  <div class="overlay" id="expired-overlay" hidden>
    <div class="panel"><h1>This meeting has ended</h1><a href="/create" class="btn btn-primary btn-lg">Start a new one</a></div>
  </div>
</div>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/room.js"></script>
<%- include('partials/chatbot') %>
<script src="/js/chatbot.js" defer></script>
</body></html>
