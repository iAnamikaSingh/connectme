<%- include('partials/head') %>
<%- include('partials/nav') %>
<main class="container narrow section page-enter">
  <h1>Create a meeting</h1>
  <form id="create-form" class="panel">
    <label>Meeting name<input name="name" maxlength="60" placeholder="Weekly sync" required></label>
    <label>Expires after
      <select name="minutes">
        <option value="15">15 minutes</option><option value="30">30 minutes</option>
        <option value="60" selected>60 minutes (default)</option><option value="120">2 hours</option>
        <option value="480">8 hours</option><option value="1440">24 hours</option>
      </select></label>
    <fieldset><legend>Who can see the expiry time?</legend>
      <label class="check"><input type="radio" name="expiryVisibleTo" value="everyone" checked> Everyone in the meeting</label>
      <label class="check"><input type="radio" name="expiryVisibleTo" value="admin"> Only me (the host)</label></fieldset>
    <p id="create-error" class="error" role="alert" hidden></p>
    <button class="btn btn-primary btn-lg"><%- include('partials/icon', { n: 'link' }) %> Generate passcode and link</button>
  </form>
  <div id="result" class="panel result" hidden>
    <h2>Your meeting is ready</h2>
    <p class="result-intro">Share both details with the people you want to invite.</p>
    <label class="generated-detail">Meeting passcode
      <span class="copy-row">
        <input id="out-code" class="code" readonly aria-label="Meeting passcode">
        <button type="button" class="btn btn-primary copy-button" data-copy="#out-code" data-copy-label="Copy passcode" aria-label="Copy meeting passcode"><%- include('partials/icon', { n: 'copy' }) %><span>Copy</span></button>
      </span>
      <span class="copy-feedback" id="code-copy-feedback" role="status" aria-live="polite"></span>
    </label>
    <label class="generated-detail">Meeting link
      <span class="copy-row">
        <input id="out-link" type="url" readonly aria-label="Meeting link">
        <button type="button" class="btn btn-primary copy-button" data-copy="#out-link" data-copy-label="Copy link" aria-label="Copy meeting link"><%- include('partials/icon', { n: 'copy' }) %><span>Copy</span></button>
      </span>
      <span class="copy-feedback" id="link-copy-feedback" role="status" aria-live="polite"></span>
    </label>
    <a id="out-start" class="btn btn-primary btn-lg">Start meeting</a>
  </div>
</main>
<%- include('partials/footer') %>
<script src="/js/create.js" defer></script>
</body></html>
